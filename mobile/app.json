{
  "expo": {
    "name": "Budget Tracker",
    "slug": "budget-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.budgettracker.mobile"
    },
    "android": {
      "package": "com.budgettracker.mobile"
    },
    "plugins": [
      "expo-secure-store",
      "expo-document-picker",
      "expo-sharing",
      "expo-status-bar"
    ]
  }
}
